# Normalize text to LF in the repository (members may use Windows, macOS or Linux).
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary types: never diffed or normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.mp3 binary
*.m4a binary
*.mp4 binary
*.pdf binary
